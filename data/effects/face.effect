uniform float4x4 ViewProj;
uniform texture2d image;
uniform int face_count;
uniform float4 face_box0;
uniform float4 face_box1;
uniform float4 face_box2;
uniform float4 face_box3;
uniform float4 face_box4;
uniform float4 face_box5;
uniform float4 face_box6;
uniform float4 face_box7;
uniform float4 face_box8;
uniform float4 face_box9;
uniform float4 face_landmarks0_0;
uniform float4 face_landmarks0_1;
uniform float4 face_landmarks0_2;
uniform float4 face_landmarks1_0;
uniform float4 face_landmarks1_1;
uniform float4 face_landmarks1_2;
uniform float4 face_landmarks2_0;
uniform float4 face_landmarks2_1;
uniform float4 face_landmarks2_2;
uniform float4 face_landmarks3_0;
uniform float4 face_landmarks3_1;
uniform float4 face_landmarks3_2;
uniform float4 face_landmarks4_0;
uniform float4 face_landmarks4_1;
uniform float4 face_landmarks4_2;
uniform float4 face_landmarks5_0;
uniform float4 face_landmarks5_1;
uniform float4 face_landmarks5_2;
uniform float4 face_landmarks6_0;
uniform float4 face_landmarks6_1;
uniform float4 face_landmarks6_2;
uniform float4 face_landmarks7_0;
uniform float4 face_landmarks7_1;
uniform float4 face_landmarks7_2;
uniform float4 face_landmarks8_0;
uniform float4 face_landmarks8_1;
uniform float4 face_landmarks8_2;
uniform float4 face_landmarks9_0;
uniform float4 face_landmarks9_1;
uniform float4 face_landmarks9_2;

uniform float4 face_box_color;
uniform float face_box_width;
uniform float4 sunglasses_box;
uniform float sunglasses_angle;
uniform texture2d sunglasses_image;
uniform float4 pirate_hat_box;
uniform float pirate_hat_angle;
uniform texture2d pirate_hat_image;
uniform float4 clown_mask_box;
uniform float clown_mask_angle;
uniform texture2d clown_mask_image;
uniform texture2d emotion_image;
uniform float emotion_alpha;
uniform float emotion_panel_alpha;
uniform float emotion_panel_score0;
uniform float emotion_panel_score1;
uniform float emotion_panel_score2;
uniform float emotion_panel_score3;
uniform float emotion_panel_score4;
uniform float emotion_panel_score5;
uniform float emotion_panel_score6;
uniform float emotion_panel_score7;
uniform float4 emotion_box0;
uniform float4 emotion_box1;
uniform float4 emotion_box2;
uniform float4 emotion_uv0;
uniform float4 emotion_uv1;
uniform float4 emotion_uv2;
uniform float4 emotion_box3;
uniform float4 emotion_box4;
uniform float4 emotion_box5;
uniform float4 emotion_box6;
uniform float4 emotion_box7;
uniform float4 emotion_box8;
uniform float4 emotion_box9;
uniform float4 emotion_uv3;
uniform float4 emotion_uv4;
uniform float4 emotion_uv5;
uniform float4 emotion_uv6;
uniform float4 emotion_uv7;
uniform float4 emotion_uv8;
uniform float4 emotion_uv9;

sampler_state linear_sampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v)
{
    v.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
    return v;
}

bool on_face_box(float2 uv, float4 box)
{
    float2 box_min = box.xy;
    float2 box_max = box.xy + box.zw;
    bool inside = uv.x >= box_min.x && uv.x <= box_max.x &&
                  uv.y >= box_min.y && uv.y <= box_max.y;
    float2 distance_to_edge = min(uv - box_min, box_max - uv);
    return inside && min(distance_to_edge.x, distance_to_edge.y) <= face_box_width;
}

bool on_landmark(float2 uv, float2 point)
{
    return point.x >= 0.0 && abs(uv.x - point.x) <= 0.006 &&
           abs(uv.y - point.y) <= 0.006;
}

void draw_landmarks(inout float3 result, float2 uv, float4 p0, float4 p1, float4 p2)
{
    if (on_landmark(uv, p0.xy) || on_landmark(uv, p0.zw) ||
        on_landmark(uv, p1.xy) || on_landmark(uv, p1.zw) ||
        on_landmark(uv, p2.xy) || on_landmark(uv, p2.zw))
        result = float3(1.0, 0.0, 1.0);
}

float2 rotated_image_uv(float2 uv, float4 box, float angle)
{
    float2 delta = (uv - (box.xy + box.zw * 0.5)) / box.zw;
    float c = cos(angle);
    float s = sin(angle);
    float2 rotated = float2(c * delta.x + s * delta.y,
                            -s * delta.x + c * delta.y);
    return rotated + float2(0.5, 0.5);
}

void blend_emotion(inout float3 result, float2 uv, float4 box, float4 atlas_rect)
{
    if (box.z <= 0.0 || box.w <= 0.0)
        return;
    float2 local_uv = (uv - box.xy) / box.zw;
    if (local_uv.x < 0.0 || local_uv.x > 1.0 ||
        local_uv.y < 0.0 || local_uv.y > 1.0)
        return;
    float2 atlas_uv = atlas_rect.xy + local_uv * atlas_rect.zw;
    float4 emoji = emotion_image.Sample(linear_sampler, atlas_uv);
    result = lerp(result, emoji.rgb, emoji.a * emotion_alpha);
}

float rounded_box(float2 uv, float left, float top, float width, float height, float radius)
{
    float2 center = float2(left + width * 0.5, top + height * 0.5);
    float2 half_size = float2(width * 0.5, height * 0.5);
    float2 q = abs(uv - center) - (half_size - radius);
    float distance_to_edge = length(max(q, 0.0)) +
                             min(max(q.x, q.y), 0.0) - radius;
    return 1.0 - smoothstep(-0.001, 0.001, distance_to_edge);
}

void blend_emotion_panel_row(inout float3 result, float2 uv, float score, float index)
{
    float panel_left = 0.82;
    float panel_top = 0.035;
    float row_height = 0.024;
    float icon_left = panel_left + 0.004;
    float icon_width = 0.018;
    float bar_left = panel_left + 0.027;
    float bar_width = 0.12;
    float y = panel_top + index * row_height;
    float2 local = uv - float2(panel_left, y);
    if (local.x < 0.0 || local.x > 0.16 || local.y < 0.0 || local.y > row_height)
        return;
    float row_top = y + 0.002;
    float row_height_inner = row_height - 0.004;
    float row_background = rounded_box(uv, panel_left + 0.003, row_top,
                                       0.154, row_height_inner, 0.006);
    result = lerp(result, float3(0.055, 0.065, 0.075), row_background * emotion_panel_alpha * 0.75);
    if (local.x >= icon_left - panel_left && local.x <= icon_left - panel_left + icon_width) {
        float2 icon_uv = float2((local.x - (icon_left - panel_left)) / icon_width,
                                local.y / row_height);
        float2 atlas_uv = float2(index / 8.0 + icon_uv.x / 8.0, icon_uv.y);
        float4 emoji = emotion_image.Sample(linear_sampler, atlas_uv);
        result = lerp(result, emoji.rgb, emoji.a * emotion_panel_alpha);
        return;
    }
    float bar_top = y + row_height * 0.34;
    float bar_height = row_height * 0.32;
    float bar_background = rounded_box(uv, bar_left, bar_top, bar_width,
                                       bar_height, bar_height * 0.5);
    result = lerp(result, float3(0.14, 0.16, 0.18),
                  bar_background * emotion_panel_alpha);
    float fill_width = max(0.001, bar_width * score);
    float bar_fill = rounded_box(uv, bar_left, bar_top, fill_width,
                                 bar_height, bar_height * 0.5);
    result = lerp(result, float3(0.20, 0.82, 0.48),
                  bar_fill * emotion_panel_alpha);
}

void blend_emotion_panel_background(inout float3 result, float2 uv)
{
    float panel_left = 0.81;
    float panel_top = 0.025;
    float panel_width = 0.17;
    float panel_height = 0.215;
    float radius = 0.012;
    float2 center = float2(panel_left + panel_width * 0.5,
                           panel_top + panel_height * 0.5);
    float2 half_size = float2(panel_width * 0.5, panel_height * 0.5);
    float2 q = abs(uv - center) - (half_size - radius);
    float distance_to_edge = length(max(q, 0.0)) +
                             min(max(q.x, q.y), 0.0) - radius;
    float outer = 1.0 - smoothstep(-0.001, 0.001, distance_to_edge);
    float2 inner_half_size = half_size - 0.002;
    float2 inner_q = abs(uv - center) - (inner_half_size - radius);
    float inner_distance = length(max(inner_q, 0.0)) +
                           min(max(inner_q.x, inner_q.y), 0.0) - radius;
    float inner = 1.0 - smoothstep(-0.001, 0.001, inner_distance);
    result = lerp(result, float3(0.05, 0.75, 0.35), outer * emotion_panel_alpha * 0.70);
    result = lerp(result, float3(0.015, 0.015, 0.02), inner * emotion_panel_alpha * 0.90);
}

float4 PSFace(VertData v) : TARGET
{
    float4 original = image.Sample(linear_sampler, v.uv);
    float3 result = original.rgb;

    if (sunglasses_box.z > 0.0 && sunglasses_box.w > 0.0) {
        float2 glasses_uv = rotated_image_uv(v.uv, sunglasses_box, sunglasses_angle);
        if (glasses_uv.x >= 0.0 && glasses_uv.x <= 1.0 &&
            glasses_uv.y >= 0.0 && glasses_uv.y <= 1.0) {
            float4 glasses = sunglasses_image.Sample(linear_sampler, glasses_uv);
            result = lerp(result, glasses.rgb, glasses.a);
        }
    }

    if (pirate_hat_box.z > 0.0 && pirate_hat_box.w > 0.0) {
        float2 hat_uv = rotated_image_uv(v.uv, pirate_hat_box, pirate_hat_angle);
        if (hat_uv.x >= 0.0 && hat_uv.x <= 1.0 &&
            hat_uv.y >= 0.0 && hat_uv.y <= 1.0) {
            float4 hat = pirate_hat_image.Sample(linear_sampler, hat_uv);
            result = lerp(result, hat.rgb, hat.a);
        }
    }

    if (clown_mask_box.z > 0.0 && clown_mask_box.w > 0.0) {
        float2 mask_uv = rotated_image_uv(v.uv, clown_mask_box, clown_mask_angle);
        if (mask_uv.x >= 0.0 && mask_uv.x <= 1.0 &&
            mask_uv.y >= 0.0 && mask_uv.y <= 1.0) {
            float4 mask = clown_mask_image.Sample(linear_sampler, mask_uv);
            result = lerp(result, mask.rgb, mask.a);
        }
    }

    blend_emotion(result, v.uv, emotion_box0, emotion_uv0);
    blend_emotion(result, v.uv, emotion_box1, emotion_uv1);
    blend_emotion(result, v.uv, emotion_box2, emotion_uv2);
    blend_emotion(result, v.uv, emotion_box3, emotion_uv3);
    blend_emotion(result, v.uv, emotion_box4, emotion_uv4);
    blend_emotion(result, v.uv, emotion_box5, emotion_uv5);
    blend_emotion(result, v.uv, emotion_box6, emotion_uv6);
    blend_emotion(result, v.uv, emotion_box7, emotion_uv7);
    blend_emotion(result, v.uv, emotion_box8, emotion_uv8);
    blend_emotion(result, v.uv, emotion_box9, emotion_uv9);

    float panel_total = emotion_panel_score0 + emotion_panel_score1 +
                        emotion_panel_score2 + emotion_panel_score3 +
                        emotion_panel_score4 + emotion_panel_score5 +
                        emotion_panel_score6 + emotion_panel_score7;
    if (panel_total > 0.0) {
        blend_emotion_panel_background(result, v.uv);
        blend_emotion_panel_row(result, v.uv, emotion_panel_score0, 0.0);
        blend_emotion_panel_row(result, v.uv, emotion_panel_score1, 1.0);
        blend_emotion_panel_row(result, v.uv, emotion_panel_score2, 2.0);
        blend_emotion_panel_row(result, v.uv, emotion_panel_score3, 3.0);
        blend_emotion_panel_row(result, v.uv, emotion_panel_score4, 4.0);
        blend_emotion_panel_row(result, v.uv, emotion_panel_score5, 5.0);
        blend_emotion_panel_row(result, v.uv, emotion_panel_score6, 6.0);
        blend_emotion_panel_row(result, v.uv, emotion_panel_score7, 7.0);
    }


    if (face_count > 0 && on_face_box(v.uv, face_box0)) result = face_box_color.rgb;
    if (face_count > 1 && on_face_box(v.uv, face_box1)) result = face_box_color.rgb;
    if (face_count > 2 && on_face_box(v.uv, face_box2)) result = face_box_color.rgb;
    if (face_count > 3 && on_face_box(v.uv, face_box3)) result = face_box_color.rgb;
    if (face_count > 4 && on_face_box(v.uv, face_box4)) result = face_box_color.rgb;
    if (face_count > 5 && on_face_box(v.uv, face_box5)) result = face_box_color.rgb;
    if (face_count > 6 && on_face_box(v.uv, face_box6)) result = face_box_color.rgb;
    if (face_count > 7 && on_face_box(v.uv, face_box7)) result = face_box_color.rgb;
    if (face_count > 8 && on_face_box(v.uv, face_box8)) result = face_box_color.rgb;
    if (face_count > 9 && on_face_box(v.uv, face_box9)) result = face_box_color.rgb;

    if (face_count > 0) draw_landmarks(result, v.uv, face_landmarks0_0, face_landmarks0_1, face_landmarks0_2);
    if (face_count > 1) draw_landmarks(result, v.uv, face_landmarks1_0, face_landmarks1_1, face_landmarks1_2);
    if (face_count > 2) draw_landmarks(result, v.uv, face_landmarks2_0, face_landmarks2_1, face_landmarks2_2);
    if (face_count > 3) draw_landmarks(result, v.uv, face_landmarks3_0, face_landmarks3_1, face_landmarks3_2);
    if (face_count > 4) draw_landmarks(result, v.uv, face_landmarks4_0, face_landmarks4_1, face_landmarks4_2);
    if (face_count > 5) draw_landmarks(result, v.uv, face_landmarks5_0, face_landmarks5_1, face_landmarks5_2);
    if (face_count > 6) draw_landmarks(result, v.uv, face_landmarks6_0, face_landmarks6_1, face_landmarks6_2);
    if (face_count > 7) draw_landmarks(result, v.uv, face_landmarks7_0, face_landmarks7_1, face_landmarks7_2);
    if (face_count > 8) draw_landmarks(result, v.uv, face_landmarks8_0, face_landmarks8_1, face_landmarks8_2);
    if (face_count > 9) draw_landmarks(result, v.uv, face_landmarks9_0, face_landmarks9_1, face_landmarks9_2);

    return float4(result, original.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v);
        pixel_shader = PSFace(v);
    }
}
