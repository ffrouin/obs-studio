uniform float4x4 ViewProj;
uniform texture2d image;
uniform int face_count;
uniform float4 face_box0;
uniform float4 face_box1;
uniform float4 face_box2;
uniform float4 face_box3;
uniform float4 face_box4;
uniform float4 face_box5;
uniform float4 face_box6;
uniform float4 face_box7;
uniform float4 face_box8;
uniform float4 face_box9;

uniform float4 face_box_color;
uniform float face_box_width;
uniform float4 sunglasses_box;
uniform float sunglasses_angle;
uniform texture2d sunglasses_image;
uniform float4 pirate_hat_box;
uniform float pirate_hat_angle;
uniform texture2d pirate_hat_image;
uniform float4 clown_mask_box;
uniform float clown_mask_angle;
uniform texture2d clown_mask_image;
uniform texture2d emotion_image;
uniform float4 emotion_box0;
uniform float4 emotion_box1;
uniform float4 emotion_box2;
uniform float4 emotion_uv0;
uniform float4 emotion_uv1;
uniform float4 emotion_uv2;
uniform float4 emotion_box3;
uniform float4 emotion_box4;
uniform float4 emotion_box5;
uniform float4 emotion_box6;
uniform float4 emotion_box7;
uniform float4 emotion_box8;
uniform float4 emotion_box9;
uniform float4 emotion_uv3;
uniform float4 emotion_uv4;
uniform float4 emotion_uv5;
uniform float4 emotion_uv6;
uniform float4 emotion_uv7;
uniform float4 emotion_uv8;
uniform float4 emotion_uv9;

sampler_state linear_sampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v)
{
    v.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
    return v;
}

bool on_face_box(float2 uv, float4 box)
{
    float2 box_min = box.xy;
    float2 box_max = box.xy + box.zw;
    bool inside = uv.x >= box_min.x && uv.x <= box_max.x &&
                  uv.y >= box_min.y && uv.y <= box_max.y;
    float2 distance_to_edge = min(uv - box_min, box_max - uv);
    return inside && min(distance_to_edge.x, distance_to_edge.y) <= face_box_width;
}

float2 rotated_image_uv(float2 uv, float4 box, float angle)
{
    float2 delta = uv - (box.xy + box.zw * 0.5);
    float c = cos(angle);
    float s = sin(angle);
    float2 rotated = float2(c * delta.x + s * delta.y,
                            -s * delta.x + c * delta.y);
    return rotated / box.zw + float2(0.5, 0.5);
}

void blend_emotion(inout float3 result, float2 uv, float4 box, float4 atlas_rect)
{
    if (box.z <= 0.0 || box.w <= 0.0)
        return;
    float2 local_uv = (uv - box.xy) / box.zw;
    if (local_uv.x < 0.0 || local_uv.x > 1.0 ||
        local_uv.y < 0.0 || local_uv.y > 1.0)
        return;
    float2 atlas_uv = atlas_rect.xy + local_uv * atlas_rect.zw;
    float4 emoji = emotion_image.Sample(linear_sampler, atlas_uv);
    result = lerp(result, emoji.rgb, emoji.a);
}

float4 PSFace(VertData v) : TARGET
{
    float4 original = image.Sample(linear_sampler, v.uv);
    float3 result = original.rgb;

    if (sunglasses_box.z > 0.0 && sunglasses_box.w > 0.0) {
        float2 glasses_uv = rotated_image_uv(v.uv, sunglasses_box, sunglasses_angle);
        if (glasses_uv.x >= 0.0 && glasses_uv.x <= 1.0 &&
            glasses_uv.y >= 0.0 && glasses_uv.y <= 1.0) {
            float4 glasses = sunglasses_image.Sample(linear_sampler, glasses_uv);
            result = lerp(result, glasses.rgb, glasses.a);
        }
    }

    if (pirate_hat_box.z > 0.0 && pirate_hat_box.w > 0.0) {
        float2 hat_uv = rotated_image_uv(v.uv, pirate_hat_box, pirate_hat_angle);
        if (hat_uv.x >= 0.0 && hat_uv.x <= 1.0 &&
            hat_uv.y >= 0.0 && hat_uv.y <= 1.0) {
            float4 hat = pirate_hat_image.Sample(linear_sampler, hat_uv);
            result = lerp(result, hat.rgb, hat.a);
        }
    }

    if (clown_mask_box.z > 0.0 && clown_mask_box.w > 0.0) {
        float2 mask_uv = rotated_image_uv(v.uv, clown_mask_box, clown_mask_angle);
        if (mask_uv.x >= 0.0 && mask_uv.x <= 1.0 &&
            mask_uv.y >= 0.0 && mask_uv.y <= 1.0) {
            float4 mask = clown_mask_image.Sample(linear_sampler, mask_uv);
            result = lerp(result, mask.rgb, mask.a);
        }
    }

    blend_emotion(result, v.uv, emotion_box0, emotion_uv0);
    blend_emotion(result, v.uv, emotion_box1, emotion_uv1);
    blend_emotion(result, v.uv, emotion_box2, emotion_uv2);
    blend_emotion(result, v.uv, emotion_box3, emotion_uv3);
    blend_emotion(result, v.uv, emotion_box4, emotion_uv4);
    blend_emotion(result, v.uv, emotion_box5, emotion_uv5);
    blend_emotion(result, v.uv, emotion_box6, emotion_uv6);
    blend_emotion(result, v.uv, emotion_box7, emotion_uv7);
    blend_emotion(result, v.uv, emotion_box8, emotion_uv8);
    blend_emotion(result, v.uv, emotion_box9, emotion_uv9);


    if (face_count > 0 && on_face_box(v.uv, face_box0)) result = face_box_color.rgb;
    if (face_count > 1 && on_face_box(v.uv, face_box1)) result = face_box_color.rgb;
    if (face_count > 2 && on_face_box(v.uv, face_box2)) result = face_box_color.rgb;
    if (face_count > 3 && on_face_box(v.uv, face_box3)) result = face_box_color.rgb;
    if (face_count > 4 && on_face_box(v.uv, face_box4)) result = face_box_color.rgb;
    if (face_count > 5 && on_face_box(v.uv, face_box5)) result = face_box_color.rgb;
    if (face_count > 6 && on_face_box(v.uv, face_box6)) result = face_box_color.rgb;
    if (face_count > 7 && on_face_box(v.uv, face_box7)) result = face_box_color.rgb;
    if (face_count > 8 && on_face_box(v.uv, face_box8)) result = face_box_color.rgb;
    if (face_count > 9 && on_face_box(v.uv, face_box9)) result = face_box_color.rgb;

    return float4(result, original.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v);
        pixel_shader = PSFace(v);
    }
}
